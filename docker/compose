#!/usr/bin/env bash
set -euo pipefail

docker_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_directory="$(dirname -- "$docker_directory")"
environment_file="${CS16_ENV_FILE:-$project_directory/.env}"
example_file="$project_directory/.env.example"

die() {
  printf 'CS16 Compose: %s\n' "$*" >&2
  exit 1
}

env_value() {
  local key="$1"
  sed -n "s/^${key}=//p" "$environment_file" 2>/dev/null | tail -n 1 | tr -d '\r'
}

set_env_value() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$environment_file"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$environment_file"
  else
    printf '\n%s=%s\n' "$key" "$value" >> "$environment_file"
  fi
}

random_secret() {
  command -v openssl >/dev/null 2>&1 || die 'openssl is required to generate secure secrets.'
  openssl rand -hex 32
}

stack_description() {
  case "$1" in
    server) printf 'Game server only' ;;
    panel) printf 'Game server + CS Control Panel + NGINX + MariaDB + Redis' ;;
    database) printf 'Game server + MariaDB fleet data' ;;
    full) printf 'Game server + Control Panel + NGINX + MariaDB + Redis' ;;
  esac
}

configure_stack() {
  local requested="${1:-}"
  if [[ ! -f "$environment_file" ]]; then
    [[ -f "$example_file" ]] || die '.env.example is missing.'
    cp "$example_file" "$environment_file"
    printf 'Created .env from .env.example.\n'
  fi

  if [[ -z "$requested" ]]; then
    [[ -t 0 ]] || die 'Non-interactive setup requires: ./docker/compose setup server|panel|database|full'
    printf '\nChoose a deployment stack:\n'
    printf '  1) Full stack (recommended)\n'
    printf '  2) Game server + Control Panel\n'
    printf '  3) Game server + MariaDB\n'
    printf '  4) Game server only\n\n'
    read -r -p 'Selection [1]: ' requested
    case "${requested:-1}" in
      1|full) requested=full ;;
      2|panel) requested=panel ;;
      3|database) requested=database ;;
      4|server) requested=server ;;
      *) die 'Choose 1, 2, 3, 4 or a stack name.' ;;
    esac
  fi

  case "$requested" in
    server|panel|database|full) ;;
    *) die 'Stack must be server, panel, database or full.' ;;
  esac

  set_env_value CS16_STACK "$requested"

  local rcon_password database_password root_password admin_password redis_password
  rcon_password="$(env_value RCON_PASSWORD)"
  if [[ -z "$rcon_password" || "$rcon_password" == change-me-now ]]; then
    set_env_value RCON_PASSWORD "$(random_secret)"
  fi

  if [[ "$requested" == panel || "$requested" == full ]]; then
    admin_password="$(env_value PANEL_ADMIN_PASSWORD)"
    redis_password="$(env_value REDIS_PASSWORD)"
    [[ -n "$(env_value PANEL_ADMIN_EMAIL)" ]] || set_env_value PANEL_ADMIN_EMAIL 'admin@example.com'
    [[ -n "$(env_value PANEL_ADMIN_NAME)" ]] || set_env_value PANEL_ADMIN_NAME 'Administrator'
    if [[ ${#admin_password} -lt 12 || "$admin_password" == change-admin-password ]]; then
      set_env_value PANEL_ADMIN_PASSWORD "$(random_secret)"
    fi
    if [[ -z "$redis_password" || "$redis_password" == change-redis-password ]]; then
      set_env_value REDIS_PASSWORD "$(random_secret)"
    fi
  fi

  if [[ "$requested" == panel || "$requested" == database || "$requested" == full ]]; then
    database_password="$(env_value DB_PASSWORD)"
    root_password="$(env_value DB_ROOT_PASSWORD)"
    if [[ -z "$database_password" || "$database_password" == change-db-password ]]; then
      set_env_value DB_PASSWORD "$(random_secret)"
    fi
    if [[ -z "$root_password" || "$root_password" == change-root-password ]]; then
      set_env_value DB_ROOT_PASSWORD "$(random_secret)"
    fi
  fi

  printf '\nConfigured: %s\n' "$(stack_description "$requested")"
  printf 'Secrets were generated when missing; their values were not printed.\n'
  printf 'Start with: ./docker/compose up -d --build\n\n'
}

configure_publish() {
  [[ -f "$environment_file" ]] || die 'Run ./docker/compose setup first.'
  local domain="${1:-}" port="${2:-443}" email="${3:-}" selected_stack
  selected_stack="$(env_value CS16_STACK)"
  [[ "$selected_stack" == panel || "$selected_stack" == full ]] || die 'Publishing requires the panel or full stack.'
  [[ "$domain" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]] || die 'Provide a public domain such as panel.example.com.'
  [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || die 'HTTPS port must be between 1 and 65535.'
  set_env_value CS16_DEPLOYMENT production
  set_env_value PANEL_DOMAIN "$domain"
  set_env_value PANEL_HTTPS_PORT "$port"
  set_env_value PANEL_SSL_EMAIL "${email:-webmaster@${domain}}"
  printf 'Production publishing enabled for https://%s%s\n' "$domain" "$([[ "$port" == 443 ]] || printf ':%s' "$port")"
  printf 'Public TCP port 80 must reach this host for the Let’s Encrypt HTTP-01 challenge.\n'
}

configure_unpublish() {
  [[ -f "$environment_file" ]] || die 'Run ./docker/compose setup first.'
  set_env_value CS16_DEPLOYMENT local
  printf 'Switched to local NGINX without SSL on http://127.0.0.1:%s.\n' "$(env_value PANEL_PORT)"
}

configure_external() {
  [[ -f "$environment_file" ]] || die 'Run ./docker/compose setup first.'
  local network="${1:-}" alias="${2:-cs16-panel}" selected_stack
  selected_stack="$(env_value CS16_STACK)"
  [[ "$selected_stack" == panel || "$selected_stack" == full ]] || die 'External mode requires the panel or full stack.'
  [[ "$network" =~ ^[a-zA-Z0-9_.-]+$ ]] || die 'Provide an existing Docker network name.'
  [[ "$alias" =~ ^[a-zA-Z0-9_.-]+$ ]] || die 'Provide a valid Docker network alias.'
  set_env_value CS16_DEPLOYMENT external
  set_env_value PANEL_EXTERNAL_NETWORK "$network"
  set_env_value PANEL_EXTERNAL_ALIAS "$alias"
  printf 'External NGINX enabled on network %s with alias %s.\n' "$network" "$alias"
  printf 'No panel host port will be published; route the upstream proxy to http://%s:80.\n' "$alias"
}

configure_engine() {
  [[ -f "$environment_file" ]] || die 'Run ./docker/compose setup first.'
  local engine="${1:-}"
  case "$engine" in
    valve|rehlds) ;;
    *) die 'Engine must be valve or rehlds.' ;;
  esac
  set_env_value SERVER_ENGINE "$engine"
  if [[ "$engine" == rehlds ]]; then
    printf 'Experimental ReHLDS/ReGameDLL profile selected. Recreate the stack with ./docker/compose up -d.\n'
  else
    printf 'Stable Valve HLDS profile selected. Recreate the stack with ./docker/compose up -d.\n'
  fi
}

show_help() {
  cat <<'EOF'
CS 1.6 Docker Compose selector

Usage:
  ./docker/compose
  ./docker/compose setup [server|panel|database|full]
  ./docker/compose publish <domain> [https-port] [email]
  ./docker/compose external <docker-network> [network-alias]
  ./docker/compose engine <valve|rehlds>
  ./docker/compose unpublish
  ./docker/compose show
  ./docker/compose doctor
  ./docker/compose <docker compose arguments...>

Examples:
  ./docker/compose
  ./docker/compose setup full
  ./docker/compose up -d
  ./docker/compose ps
  ./docker/compose logs -f server panel mariadb
  ./docker/compose down

The selected stack and local/production environment are stored in .env.
Advanced users can still use the Compose overlay files directly.
Set CS16_ENV_FILE=/path/to/file to use a different environment file in CI.
EOF
}

interactive_menu() {
  [[ -t 0 ]] || { show_help; return; }

  if [[ ! -f "$environment_file" ]]; then
    printf 'No configuration found. Starting first-time setup.\n'
    configure_stack
  fi

  while true; do
    local selected_stack selected_deployment choice confirmation
    selected_stack="$(env_value CS16_STACK)"
    selected_deployment="$(env_value CS16_DEPLOYMENT)"
    printf '\nCS 1.6 Docker Control\n'
    printf 'Stack: %s | Deployment: %s\n\n' "${selected_stack:-server}" "${selected_deployment:-local}"
    printf '  1) Start or update the stack\n'
    printf '  2) Show service status\n'
    printf '  3) Follow logs\n'
    printf '  4) Restart services\n'
    printf '  5) Stop and remove the complete stack\n'
    printf '  6) Stop and remove the stack plus all data volumes\n'
    printf '  7) Change stack configuration\n'
    printf '  8) Run diagnostics\n'
    printf '  9) Exit\n\n'
    read -r -p 'Choose an action: ' choice

    case "$choice" in
      1) "$0" up -d ;;
      2) "$0" ps ;;
      3) "$0" logs --tail=100 -f || true ;;
      4) "$0" restart ;;
      5) "$0" down ;;
      6)
        printf 'This permanently removes MariaDB, Redis, AMXX and log volumes.\n'
        read -r -p 'Type DELETE to continue: ' confirmation
        if [[ "$confirmation" == DELETE ]]; then
          "$0" down -v
        else
          printf 'Cancelled.\n'
        fi
        ;;
      7) configure_stack ;;
      8) "$0" doctor ;;
      9) return ;;
      *) printf 'Choose a number from 1 to 9.\n' ;;
    esac
  done
}

case "${1:-}" in
  setup)
    shift
    configure_stack "${1:-}"
    exit 0
    ;;
  publish)
    shift
    configure_publish "${1:-}" "${2:-443}" "${3:-}"
    exit 0
    ;;
  external)
    shift
    configure_external "${1:-}" "${2:-cs16-panel}"
    exit 0
    ;;
  engine)
    shift
    configure_engine "${1:-}"
    exit 0
    ;;
  unpublish)
    configure_unpublish
    exit 0
    ;;
  help|-h|--help)
    show_help
    exit 0
    ;;
esac

if [[ $# -eq 0 ]]; then
  interactive_menu
  exit 0
fi

[[ -f "$environment_file" ]] || die 'Run ./docker/compose setup first.'

stack="$(env_value CS16_STACK)"
stack="${stack:-server}"
case "$stack" in
  server|panel|database|full) ;;
  *) die 'CS16_STACK in .env must be server, panel, database or full.' ;;
esac
deployment="$(env_value CS16_DEPLOYMENT)"
deployment="${deployment:-local}"
case "$deployment" in
  local|production|external) ;;
  *) die 'CS16_DEPLOYMENT in .env must be local, production or external.' ;;
esac
engine="$(env_value SERVER_ENGINE)"
engine="${engine:-valve}"
case "$engine" in
  valve|rehlds) ;;
  *) die 'SERVER_ENGINE in .env must be valve or rehlds.' ;;
esac

compose_arguments=(
  --project-directory "$project_directory"
  --env-file "$environment_file"
  --file "$docker_directory/compose.yaml"
)

if [[ "$engine" == rehlds ]]; then
  compose_arguments+=(--file "$docker_directory/compose.rehlds.yaml")
fi

if [[ "${1:-}" == down ]]; then
  # A project-wide down must see services from the previously selected stack,
  # even when CS16_STACK has since been changed in .env.
  compose_arguments+=(--file "$docker_directory/compose.database.yaml")
  compose_arguments+=(--file "$docker_directory/compose.${deployment}.yaml")
  compose_arguments+=(--profile panel)
else
  if [[ "$stack" == panel || "$stack" == database || "$stack" == full ]]; then
    compose_arguments+=(--file "$docker_directory/compose.database.yaml")
  fi
  if [[ "$stack" == panel || "$stack" == full ]]; then
    compose_arguments+=(--file "$docker_directory/compose.${deployment}.yaml")
    compose_arguments+=(--profile panel)
  fi
fi

if [[ "${1:-}" == show ]]; then
  compose_files='docker/compose.yaml'
  if [[ "$stack" == panel || "$stack" == database || "$stack" == full ]]; then
    compose_files+=' + docker/compose.database.yaml'
  fi
  if [[ "$stack" == panel || "$stack" == full ]]; then
    compose_files+=" + docker/compose.${deployment}.yaml"
  fi
  printf 'Selected stack: %s\n' "$stack"
  printf 'Services: %s\n' "$(stack_description "$stack")"
  printf 'Environment: %s\n' "$environment_file"
  printf 'Compose files: %s\n' "$compose_files"
  printf 'Deployment: %s\n' "$deployment"
  printf 'Game engine: %s\n' "$engine"
  if [[ "$deployment" == production && ( "$stack" == panel || "$stack" == full ) ]]; then
    printf 'Public panel: https://%s%s\n' "$(env_value PANEL_DOMAIN)" "$([[ "$(env_value PANEL_HTTPS_PORT)" == 443 ]] || printf ':%s' "$(env_value PANEL_HTTPS_PORT)")"
  elif [[ "$deployment" == external && ( "$stack" == panel || "$stack" == full ) ]]; then
    printf 'External panel: http://%s:80 on Docker network %s\n' "$(env_value PANEL_EXTERNAL_ALIAS)" "$(env_value PANEL_EXTERNAL_NETWORK)"
  elif [[ "$stack" == panel || "$stack" == full ]]; then
    printf 'Panel URL: http://127.0.0.1:%s\n' "$(env_value PANEL_PORT)"
  else
    printf 'Panel: not selected\n'
  fi
  exit 0
fi

if [[ "${1:-}" == doctor ]]; then
  command -v docker >/dev/null 2>&1 || die 'docker is not installed or not in PATH.'
  docker compose version >/dev/null || die 'Docker Compose plugin is unavailable.'
  docker info >/dev/null || die 'Docker Engine is unavailable or permission is denied.'
  [[ "$(env_value RCON_PASSWORD)" != change-me-now ]] || die 'RCON_PASSWORD still uses the example value. Run setup again.'
  if [[ "$stack" == panel || "$stack" == full ]]; then
    admin_password="$(env_value PANEL_ADMIN_PASSWORD)"
    [[ ${#admin_password} -ge 12 ]] || die 'PANEL_ADMIN_PASSWORD is missing or too short. Run setup again.'
    [[ "$(env_value REDIS_PASSWORD)" != change-redis-password ]] || die 'REDIS_PASSWORD still uses the example value. Run setup again.'
  fi
  if [[ "$stack" == panel || "$stack" == database || "$stack" == full ]]; then
    [[ "$(env_value DB_PASSWORD)" != change-db-password ]] || die 'DB_PASSWORD still uses the example value. Run setup again.'
    [[ "$(env_value DB_ROOT_PASSWORD)" != change-root-password ]] || die 'DB_ROOT_PASSWORD still uses the example value. Run setup again.'
  fi
  docker compose "${compose_arguments[@]}" config >/dev/null
  printf 'OK: Docker, secrets and %s stack configuration are ready.\n' "$stack"
  exit 0
fi

[[ $# -gt 0 ]] || { show_help; exit 0; }

if [[ "$1" == down ]]; then
  mapfile -t project_containers < <(docker ps -aq --filter 'label=com.docker.compose.project=cs16')
  if (( ${#project_containers[@]} > 0 )); then
    printf 'Removing %d container(s) belonging to the cs16 project.\n' "${#project_containers[@]}"
    docker rm -f "${project_containers[@]}" >/dev/null
  fi
  exec docker compose "${compose_arguments[@]}" down --remove-orphans "${@:2}"
fi

# Local images are part of this repository. Rebuild them on `up` so a stale
# panel image cannot run newer Compose commands with an older package.json.
if [[ "$1" == up ]]; then
  has_build_flag=0
  has_remove_orphans_flag=0
  for argument in "$@"; do
    if [[ "$argument" == --build || "$argument" == --no-build ]]; then
      has_build_flag=1
    elif [[ "$argument" == --remove-orphans ]]; then
      has_remove_orphans_flag=1
    fi
  done
  compose_command=(up)
  if (( has_build_flag == 0 )); then
    compose_command+=(--build)
  fi
  if (( has_remove_orphans_flag == 0 )); then
    compose_command+=(--remove-orphans)
  fi
  compose_command+=("${@:2}")
  exec docker compose "${compose_arguments[@]}" "${compose_command[@]}"
fi

exec docker compose "${compose_arguments[@]}" "$@"
