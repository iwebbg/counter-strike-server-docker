# Deployment stack used by ./docker/compose:
# server, panel, database or full
CS16_STACK=server
SERVER_ENGINE=valve

# Game mode: classic or gungame
SERVER_MODE=classic
SERVER_NAME=My CS 1.6 Server
SERVER_PORT=27015
MAX_PLAYERS=24
# Leave empty to use de_dust2 for classic or gg_3way for GunGame.
START_MAP=
# Leave empty to use the mode-specific list from configs/maps/.
MAPCYCLE=
RCON_PASSWORD=change-me-now
SERVER_PASSWORD=
SV_LAN=0
REGION=3
WELCOME_MESSAGE=Welcome to our CS 1.6 server!
# Replaces the stock "This server is using AMX Mod X" scroll/HUD advertisements.
# AMXX color uses three zero-padded RGB values: RRRGGGBBB.
AMXX_BRANDING_MESSAGE=%hostname% is powered by CS 1.6 Server CP | interweb.bg
AMXX_BRANDING_INTERVAL=600
AMXX_BRANDING_COLOR=201255074

# GunGame only: one additional jump while airborne.
GG_DOUBLEJUMP_ENABLED=1
GG_DOUBLEJUMP_VELOCITY=350.0

# Recommended gameplay pack.
WARMUP_ENABLED=1
WARMUP_SECONDS=45
# Leave empty for mode default: enabled in GunGame, disabled in Classic.
SPAWN_PROTECTION_ENABLED=
SPAWN_PROTECTION_SECONDS=3.0
SEMICLIP_ENABLED=1
AFK_MANAGER_ENABLED=1
AFK_WARN_SECONDS=60
AFK_SPECTATOR_SECONDS=90
AFK_KICK_SECONDS=180
RTV_ENABLED=1
RTV_RATIO=0.60
RTV_MIN_VOTES=2
RTV_DELAY_SECONDS=120
RECENT_MAPS=3

# Original synthesized kill-streak announcements for both game modes.
KILLSTREAK_ENABLED=1
KILLSTREAK_SOUNDS_ENABLED=1
KILLSTREAK_HUD_ENABLED=1
# 1 announces to everyone; 0 announces only to the killer.
KILLSTREAK_GLOBAL=1
KILLSTREAK_MULTI_WINDOW=4.0

# SteamID|access-flags entries separated by semicolons. Never add the z flag.
# Full admin example: STEAM_0:1:123456|abcdefghijklmnopqrstu
AMXX_ADMINS=

# Optional central fleet data, rankings, seasons and moderation.
# Use compose.database.yaml to enable it and replace both example passwords.
DB_ENABLED=0
DB_HOST=mariadb
DB_NAME=cs16
DB_USER=cs16
DB_PASSWORD=change-db-password
DB_ROOT_PASSWORD=change-root-password
SERVER_ID=cs16-1

# CS Control login. setup generates the initial password and Redis secret.
PANEL_ADMIN_NAME=Administrator
PANEL_ADMIN_EMAIL=admin@example.com
PANEL_ADMIN_PASSWORD=change-admin-password
REDIS_PASSWORD=change-redis-password
AUTH_COOKIE_NAME=cs_control_session
AUTH_ACCESS_TOKEN_LIFETIME=3600
AUTH_REFRESH_TOKEN_LIFETIME=1209600
AUTH_COOKIE_TTL_LIFETIME=1209600
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
# Allows base64-encoded custom map packages up to 32 MiB of raw files.
REQUEST_BODY_LIMIT=48mb
DB_BACKUP_IMAGE=mariadb:11.8
SWAGGER_UI_ENABLED=false

# NGINX publishes the panel; panel:8080 stays internal.
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8080
PORT_RANGE_START=27015
PORT_RANGE_END=27115
PANEL_ALLOWED_NETWORKS=cs16_default
BACKUP_SCHEDULER_ENABLED=1
BACKUP_SCHEDULER_INTERVAL_MS=60000
COMMUNITY_EVENT_SCHEDULER_ENABLED=1
COMMUNITY_EVENT_SCHEDULER_INTERVAL_MS=60000
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
TEAM_BALANCE_ENABLED=1
TEAM_SCRAMBLE_ENABLED=1
TEAM_SCRAMBLE_STREAK=5
RADIO_PROTECTION_ENABLED=1
RADIO_SPAM_LIMIT=4
RADIO_SPAM_WINDOW=5.0
SERVER_RULES=Respect players; no cheating; no abuse; follow admin instructions.
COMMUNITY_URL=https://interweb.bg
SAFE_NAME_ENABLED=1
SAFE_CHAT_ENABLED=1
CHAT_SPAM_LIMIT=5
CHAT_SPAM_WINDOW=6.0
CHAT_BLOCK_SECONDS=15
FORBIDDEN_NAMES=console,server,admin
FORBIDDEN_CHAT=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=3000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
MODERATION_RATE_LIMIT_WINDOW_MS=60000
MODERATION_RATE_LIMIT_MAX=30
EVIDENCE_READY_TIMEOUT_MS=20000
EVIDENCE_MAX_BYTES=536870912
EVIDENCE_RETENTION_ENABLED=1
EVIDENCE_RETENTION_INTERVAL_MS=21600000
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_RETENTION_COUNT=50
SERVER_LOG_RETENTION_DAYS=30
# Optional exact client IP/VPN allowlist, comma-separated. Empty allows all.
PANEL_ALLOWED_IPS=

# Optional forward-auth SSO (oauth2-proxy, Authelia or a trusted reverse proxy).
# The proxy must remove client-supplied identity headers and inject both headers below.
SSO_ENABLED=0
SSO_SHARED_SECRET=
SSO_EMAIL_HEADER=x-auth-request-email

# NGINX environment: local (HTTP) or production (domain + Let's Encrypt).
# Enable with: ./docker/compose publish panel.example.com 443 admin@example.com
CS16_DEPLOYMENT=local
PANEL_DOMAIN=panel.example.com
PANEL_SSL_EMAIL=
PANEL_PROXY_BIND_IP=0.0.0.0
PANEL_HTTP_PORT=80
# Public HTTPS host port. It does not need to be 443.
PANEL_HTTPS_PORT=443

# Existing Docker network mode for an upstream reverse proxy/preview stack.
PANEL_EXTERNAL_NETWORK=server1_net
PANEL_EXTERNAL_ALIAS=cs16-panel

