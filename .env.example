# Game mode: classic or gungame
SERVER_MODE=classic
SERVER_NAME=My CS 1.6 Server
SERVER_PORT=27015
MAX_PLAYERS=24
# Leave empty to use de_dust2 for classic or gg_3way for GunGame.
START_MAP=
# Leave empty to use the mode-specific list from configs/maps/.
MAPCYCLE=
RCON_PASSWORD=change-me-now
SERVER_PASSWORD=
SV_LAN=0
REGION=3
WELCOME_MESSAGE=Welcome to our CS 1.6 server!

# GunGame only: one additional jump while airborne.
GG_DOUBLEJUMP_ENABLED=1
GG_DOUBLEJUMP_VELOCITY=350.0

# Recommended gameplay pack.
WARMUP_ENABLED=1
WARMUP_SECONDS=45
# Leave empty for mode default: enabled in GunGame, disabled in Classic.
SPAWN_PROTECTION_ENABLED=
SPAWN_PROTECTION_SECONDS=3.0
SEMICLIP_ENABLED=1
AFK_MANAGER_ENABLED=1
AFK_WARN_SECONDS=60
AFK_SPECTATOR_SECONDS=90
AFK_KICK_SECONDS=180
RTV_ENABLED=1
RTV_RATIO=0.60
RTV_MIN_VOTES=2
RTV_DELAY_SECONDS=120
RECENT_MAPS=3

# SteamID|access-flags entries separated by semicolons. Never add the z flag.
# Full admin example: STEAM_0:1:123456|abcdefghijklmnopqrstu
AMXX_ADMINS=

# Optional central fleet data, rankings, seasons and moderation.
# Use compose.database.yaml to enable it and replace both example passwords.
DB_ENABLED=0
DB_HOST=mariadb
DB_NAME=cs16
DB_USER=cs16
DB_PASSWORD=change-db-password
DB_ROOT_PASSWORD=change-root-password
SERVER_ID=cs16-1

# Optional local CS Control Panel (`docker compose --profile panel ...`).
# Generate with: openssl rand -hex 24
PANEL_TOKEN=
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8080
PORT_RANGE_START=27015
PORT_RANGE_END=27115

